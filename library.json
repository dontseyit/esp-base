{
  "name": "EspBase",
  "version": "2.0.0",
  "description": "Common ground for ESP32 projects: WiFi with AP fallback and captive portal, browser and serial console with live logs and commands, OTA, NVS settings, logging, NTP time and an optional app framework. Arduino core 3.x.",
  "keywords": "esp32, esp32-s3, esp32-c3, wifi, captive portal, ota, websocket, console, logging, ntp, framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/dontseyit/esp-base.git"
  },
  "authors": [
    {
      "name": "Seyit Zor",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "EspBase.h",
  "dependencies": [
    {
      "owner": "ESP32Async",
      "name": "AsyncTCP",
      "version": "^3.5.0"
    },
    {
      "owner": "ESP32Async",
      "name": "ESPAsyncWebServer",
      "version": "^3.12.0"
    },
    {
      "owner": "bblanchon",
      "name": "ArduinoJson",
      "version": "^7.4.0"
    }
  ],
  "export": {
    "exclude": [
      ".github",
      ".pio",
      "webui",
      "tools",
      "platformio.ini",
      "docs",
      "test",
      ".vscode",
      ".clang-format",
      ".editorconfig",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "CHANGELOG.md"
    ]
  }
}
